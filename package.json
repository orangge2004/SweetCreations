{
  "name": "sweetcreations",
  "version": "0.1.0",
  "private": true,
  "description": "Catálogo web y panel de administración para SweetCreations",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
